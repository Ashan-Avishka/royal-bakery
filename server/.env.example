# --- Server ---
PORT=4000
# Allowed CORS origin (the Next.js app)
CLIENT_ORIGIN=http://localhost:3000

# --- Supabase (dashboard → Project Settings → API) ---
SUPABASE_URL=
# service_role key — server only, NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- PayHere (https://www.payhere.lk → merchant account) ---
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# sandbox | live
PAYHERE_MODE=sandbox
# Public base URL of this API -- PayHere's notify_url webhook calls this
# directly, server-to-server. localhost will NOT work for real PayHere
# calls; use a tunnel (e.g. ngrok) for that, or your deployed URL in production.
API_PUBLIC_URL=http://localhost:4000

# --- SMTP (order confirmations / notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank
SMTP_FROM_EMAIL=
# Where new-order and low-stock admin alerts are sent
ADMIN_NOTIFICATION_EMAIL=
